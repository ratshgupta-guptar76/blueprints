  type (BUS32) {
    base_type : array;
    data_type : bit;
    bit_width : 32;
    bit_from  : 31;
    bit_to    : 0;
    downto    : true;
  }
  type (BUS8) {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from  : 7;
    bit_to    : 0;
    downto    : true;
  }
  type (BUS256) {
    base_type : array;
    data_type : bit;
    bit_width : 256;
    bit_from  : 255;
    bit_to    : 0;
    downto    : true;
  }

